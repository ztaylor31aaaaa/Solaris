{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solaris",
  "main": "./_worker.js",
  "compatibility_date": "2026-11-12",
  "durable_objects": { "bindings": [{ "name": "PRESENCE", "class_name": "PresenceCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceCounter"] }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  }
}
