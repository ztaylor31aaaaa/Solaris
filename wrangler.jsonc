{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solaris",
  "main": "./_worker.js",
  "compatibility_date": "2026-11-12",
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "PresenceCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PresenceCounter"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "GAMES_BUCKET",
      "bucket_name": "solaris-games"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*"
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
